{
  "name": "data-unit-converter",
  "description": "A simple data unit converter",
  "version": "1.2.11",
  "author": "Jhordy Gavinchu",
  "keywords": [
    "react",
    "data-conversion",
    "mathjs",
    "typescript"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "start": "vite preview",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "ts-check": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "validate": "pnpm lint && pnpm ts-check && pnpm test --run",
    "format": "prettier --write .",
    "prepare": "husky",
    "postinstall": "pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.43.0",
    "mathjs": "^15.3.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
